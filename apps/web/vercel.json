{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "*/*": false
    }
  },
  "rewrites": [
    {
      "source": "/event/:slug/game",
      "destination": "/index.html"
    },
    {
      "source": "/event/:slug/game/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/event/:slug/admin",
      "destination": "/index.html"
    },
    {
      "source": "/event/:slug/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/event/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/event/:slug(harvest-block-party|riverside-jam)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/event/:slug(madrona)/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
