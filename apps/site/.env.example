NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Canonical user-facing origin for absolute URLs in SSR metadata
# (Open Graph / Twitter card image URLs, og:url). apps/site is the
# canonical project per docs/plans/canonical-origin-resolution.md, so
# in the apps/site Vercel project's Production environment set this to
# apps/site's primary Vercel alias (the canonical user-facing origin).
# Local dev typically uses `http://localhost:3000`.
NEXT_PUBLIC_SITE_ORIGIN=
